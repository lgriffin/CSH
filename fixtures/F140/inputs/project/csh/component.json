{
  "schema": "csh-component/v2",
  "name": "Ladder",
  "spec": "csh/spec.csl.ts",
  "implementation": ["src"],
  "sources": [
    { "name": "Reqs", "kind": "Documents", "at": "docs/requirements.md" },
    { "name": "Tests", "kind": "TestFiles", "at": ".", "include": ["tests/**/*.ts"] },
    { "name": "Code", "kind": "Code", "at": ".", "include": ["src/**/*.ts", "tests/**/*.ts"] }
