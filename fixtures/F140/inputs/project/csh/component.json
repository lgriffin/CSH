  "practices": [
    { "id": "reqs", "name": "Requirements", "kind": "requirements", "sources": ["Reqs"], "adapter": "@csh/adapter-items/markdown", "settings": { "idPattern": "R-[A-Z]+-[0-9]+" } },
    { "id": "ears", "name": "EARS", "kind": "requirements", "sources": ["Ears"] },
    { "id": "tests", "name": "Tests", "kind": "tests", "sources": ["Tests"], "settings": { "idPattern": "R-[A-Z]+-[0-9]+" } },
    { "id": "code", "name": "Code facts", "kind": "facts", "sources": ["Code"] }
  ]
}
