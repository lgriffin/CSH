{
  "identities": {
    "owner": {
      "kind": "person",
      "roles": [
        "intent-owner",
        "domain-reviewer"
      ]
    },
    "reviewer": {
      "kind": "person",
      "roles": [
        "intent-owner",
        "domain-reviewer"
      ]
    }
  },
  "commits": [
    {
      "signer": "owner",
      "message": "root of trust",
      "maintainers": [
        "owner"
      ]
    },
    {
      "signer": "owner",
      "message": "second maintainer",
      "maintainers": [
        "owner",
        "reviewer"
      ]
    },
    {
      "signer": "owner",
      "message": "owner writes the specification",
      "spec": true
    },
    {
      "signer": "owner",
      "message": "owner approves own work",
      "ledger": [
        {
          "kind": "approve",
          "fragment": "AccountService/ProtectFunds/MinimumBalance",
          "actor": "owner"
        }
      ]
    }
  ]
}
