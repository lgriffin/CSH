{
  "identities": {
    "owner": {
      "kind": "person",
      "roles": [
        "intent-owner",
        "domain-reviewer"
      ]
    },
    "assistant": {
      "kind": "agent",
      "roles": [
        "contributor"
      ]
    }
  },
  "commits": [
    {
      "signer": "owner",
      "message": "root of trust",
      "maintainers": [
        "owner",
        "assistant"
      ],
      "spec": true
    },
    {
      "signer": "assistant",
      "message": "agent tries to approve",
      "ledger": [
        {
          "kind": "approve",
          "fragment": "AccountService/ProtectFunds/MinimumBalance",
          "actor": "assistant"
        }
      ]
    }
  ]
}
