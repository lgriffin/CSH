%% The shop's containers: each names the package that builds it.
C4Container
  title Shop: containers
  System_Boundary(shop, "Shop") {
    Container(web, "Web", "example.com/shop/web", "Pages and the API")
    Container(core, "Core", "example.com/shop/core", "Orders and prices")
    Container(db, "Database access", "example.com/shop/db", "Tables")
  }
  Rel(web, core, "Calls")
