%% C4 level 3: components of the adapters container.
C4Component
  title Adapters: components
  Container_Boundary(ad, "Adapters (witness, adapter-witness-files, adapter-ears-markdown, adapter-gherkin)") {
    Component(format, "Witness format", "witness/src/witness.ts", "csh-witness/v1 and v2, csh-execution/v1, adapter contract, witness digest")
    Component(recorder, "Recorder", "witness/src/record.ts", "recordWitness helper for any JavaScript test")
    Component(reader, "Witness reader", "witness/src/witness.ts (parseWitnesses)", "Parses and validates records; reports malformed lines")
    Component(lifter, "Example lifter", "adapter-witness-files/src/adapter.ts", "Joins records to outcomes by test identity; passing records to example claims through reversed bindings")
    Component(scenarios, "Scenario lifter", "adapter-gherkin/src/adapter.ts", "Loads the project's step table in the sandbox; scenarios to example claims; tags to citations")
    Component(extractor, "Sentence extractor", "adapter-ears-markdown/src/adapter.ts", "Identified EARS sentences; pattern; text digest")
    Component(runner, "Isolated runner", "run/src/adapter-runner.ts", "Permission-restricted subprocess; bytes in, output out")
  }
  Rel(recorder, format, "Writes")
  Rel(reader, format, "Validates")
  Rel(lifter, reader, "Uses")
  Rel(runner, lifter, "Runs")
  Rel(runner, extractor, "Runs")
  Rel(runner, scenarios, "Runs, with read access to the step table only")
