%% C4 level 3: components of the command line.
C4Component
  title Command line: components
  Container_Boundary(cl, "Command line (cli)") {
    Component(csl, "csl command", "cli/src/csl.ts", "emit, print, lock")
    Component(csh, "csh command", "cli/src/csh.ts", "run, check, gaps, coverage, overview, ladder, expect, explain, results import, subject fetch, approve, reject, retire, waive, countersign, gate, status, queue")
    Component(init, "Init", "cli/src/init.ts", "Asks for each manifest field and never overwrites; with --subject, prints a proposed profile beside what each guess was read from")
    Component(diff, "Diff", "cli/src/diff.ts", "csh diff: two sides, each a stored run, a commit or the working tree")
    Component(a3, "A3 and history", "cli/src/a3.ts", "csh a3 open, stage, build, verify; csh history over release tags")
  }
  Container_Ext(run, "Run", "run", "Project, pipeline, evaluation, run record, proposal")
  Container_Ext(component, "Component", "component", "Manifest validation")
  Container_Ext(check, "Check engine", "check", "Overview, ladder, expected results")
  Container_Ext(review, "Change review", "review", "Diff model and rendering")
  Container_Ext(a3c, "A3", "a3", "Stage records and judgments")
  Rel(csh, run, "Evaluates, runs, decides")
  Rel(csh, check, "overview, ladder, expect over a report")
  Rel(csh, init, "csh init")
  Rel(csh, diff, "csh diff")
  Rel(csh, a3, "csh a3, csh history")
  Rel(diff, review, "Two stored runs, the changed paths, the manifest")
  Rel(a3, a3c, "Builds and verifies")
  Rel(init, component, "Validates the answers")
  Rel(init, run, "proposeProfile")
  Rel(csl, run, "Loads the project")
