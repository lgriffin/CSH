%% C4 level 3: components of the run (Anchor, harnesses and A3, section 4).
C4Component
  title Run: components
  Container_Boundary(r, "Run (run)") {
    Component(project, "Project", "run/src/project.ts", "Config, manifest, lock, HEAD and dirty state, ledger from history, snapshot with the manifest digest")
    Component(harnesses, "Harness runner", "run/src/run.ts", "Runs each practice's harness command; CSH_COMMIT, CSH_WITNESS_FILE, CSH_EXECUTIONS_FILE")
    Component(sources, "Source runner", "run/src/sources.ts", "Reads source files; a practice's adapter overrides the built-in one")
    Component(isolate, "Adapter runner", "run/src/adapter-runner.ts", "One permission-restricted subprocess per adapter, input over IPC")
    Component(pipeline, "Pipeline", "run/src/pipeline.ts", "Emit, check the manifest against the module, run sources, check")
    Component(evaluate, "Evaluation", "run/src/evaluate.ts", "One evaluation of a project and its gate decision, shared by check, gate and run")
    Component(store, "Run store", "run/src/run.ts", "csh-run/v1 under .csh-cache/runs/<snapshot digest>/ with report.json, gate.json and model.json")
    Component(status, "Status", "run/src/status.ts", "csh status: root of trust, maintainers, authority counts, mode, stored decision against the current snapshot; reads only")
    Component(at, "Past-commit runner", "run/src/run.ts (runAt)", "Throwaway worktree; refuses when dependency files differ")
  }
  Container_Ext(component, "Component", "component", "Manifest")
  Container_Ext(check, "Check engine", "check, solver", "Report")
  Container_Ext(gate, "Gate", "gate", "Decision")
  System_Ext(vcs, "Version control", "git")
  Rel(project, component, "Loads csh/component.json")
  Rel(store, harnesses, "Runs first")
  Rel(store, evaluate, "Then evaluates")
  Rel(evaluate, project, "Snapshot, ledger")
  Rel(evaluate, pipeline, "Runs")
  Rel(pipeline, sources, "Runs")
  Rel(sources, isolate, "Each adapter")
  Rel(pipeline, check, "Module, sources, owners")
  Rel(evaluate, gate, "Report, snapshot, waivers")
  Rel(at, vcs, "worktree add, remove")
  Rel(at, store, "Stores under the project")
  Rel(status, project, "Ledger, snapshot")
  Rel(status, sources, "Items, for cited text")
