%% C4 level 2: containers (Architecture tab, section 2).
%% Every package under packages/ appears here by name; a docs test checks this.
C4Container
  title CSH: containers
  Person(user, "Contributor, intent owner or agent")
  System_Boundary(csh, "Composable Specification Harness") {
    Container(cli, "Command line", "cli", "csl and csh commands; csh init; argument parsing and printing")
    Container(run, "Run", "run", "Harnesses, sources, the pipeline, the gate decision and the run record")
    Container(a3, "A3", "a3", "Stage records and judgments to one model; Markdown and HTML renderings; checks on the judgments")
    Container(component, "Component", "component", "The component manifest: practices, the sources each owns, harnesses")
    Container(emission, "Emission sandbox", "emit, csl, print", "Locked-down subprocess per module; rules S6 to S9; canonical printer")
    Container(harness, "Harnesses", "harness, facts-imports", "Probe in the project's tests; reporter for Node's test runner (runs in the test process); the import scan that writes dependency facts")
    Container(adapters, "Adapters", "adapter-witness-files, adapter-ears-markdown, adapter-gherkin, adapter-c4-mermaid, facts, witness", "Isolated subprocess per adapter; claims, witnesses, items, the diagram and the facts")
    Container(ledger, "Ledger and authority", "ledger", "Maintainers, entries, signatures through git; authority of each fragment")
    Container(check, "Check engine", "check, solver", "Pool, queries, minimal sets, witness judging, gap view, report")
    Container(arch, "Architecture rules", "arch", "Rule selectors and set comparisons: verdicts, conflicts with the diagram and gaps, without a solver")
    Container(gate, "Gate", "gate", "Snapshots, dispositions, waivers, decision record")
    Container(kernel, "Kernel", "kernel", "Model types, typing, canonical JSON, digests, exact evaluation")
    Container(testkit, "Test kit (development only)", "testkit", "Fixture runner, independent result checks, local packing and the triangle checks")
  }
  System_Ext(vcs, "Version control", "git and gpg")
  System_Ext(z3, "Z3", "z3-solver, WebAssembly")
  Rel(user, cli, "Runs")
  Rel(cli, run, "Evaluate, run, decide")
  Rel(cli, component, "csh init writes the manifest")
  Rel(cli, a3, "csh a3: stage records, authority, files at a commit")
  Rel(a3, check, "Report types, signals and matching")
  Rel(a3, component, "Practices")
  Rel(run, component, "Manifest, owners of sources")
  Rel(run, emission, "Model of each module")
  Rel(run, adapters, "Source bytes in, claims out (IPC)")
  Rel(run, ledger, "Ledger state")
  Rel(run, check, "Module, adapter output, authority, owners")
  Rel(run, gate, "Report, snapshot, waivers")
  Rel(run, vcs, "Worktree for a past commit")
  Rel(run, harness, "Runs each practice's harness command")
  Rel(harness, adapters, "Witness and execution files")
  Rel(ledger, vcs, "git log, %G?, %GF")
  Rel(check, z3, "Through SolverPort")
  Rel(check, arch, "Rules, the diagram, current facts")
  Rel(gate, check, "Report types")
  Rel(gate, ledger, "Waivers")
  Rel(emission, kernel, "Uses")
  Rel(adapters, kernel, "Uses")
  Rel(check, kernel, "Uses")
  Rel(arch, kernel, "Uses")
  Rel(ledger, kernel, "Uses")
  Rel(component, kernel, "Uses")
  Rel(testkit, run, "Runs fixtures end to end")
