%% C4 level 3: components of the check engine (Architecture tab, section 3; Ingesting a codebase; The Assertion Ladder).
C4Component
  title Check engine: components
  Container_Boundary(check, "Check engine (check, solver)") {
    Component(pool, "Pool and comparability", "check/src/pool.ts", "Merges adapter claims; type-checks them; unit mismatches to not comparable, other failures to unliftable")
    Component(run, "Query runner", "check/src/run.ts", "Builds the pool and runs Q-STATE, Q-VAC, Q-FEAS, Q-EX, Q-PRES, Q-MEET, Q-DIV")
    Component(queries, "Query encoder", "solver/src/queries.ts, formula.ts", "Encodes the seven queries; minimises unsatisfiable cores")
    Component(port, "Solver port", "solver/src/port.ts, z3.ts, fake.ts", "Z3 behind an interface; a fake for fault injection")
    Component(cache, "Solver cache", "check/src/cache.ts", "Stores sat and unsat answers only")
    Component(evidence, "Witness judge and evidence store", "check/src/evidence.ts", "Bindings, keys, policy, freshness, exact evaluation")
    Component(assess, "Assessor", "check/src/assess.ts", "Verdict, applicability and methods per obligation")
    Component(archwire, "Architecture", "check/src/arch.ts", "Finds the diagram and the facts in adapter output, decides whether the facts are current; rule and claim results, arch-conflict, diagram gaps")
    Component(trace, "Trace", "check/src/trace.ts, steps.ts", "Resolves each edge against items and tracked files; unverified, uncited and dangling gaps; what checks each item; scenario steps against definitions")
    Component(results, "Test results", "check/src/results.ts", "What a runner said of each test, per file and per cited item; never a verdict")
    Component(gaps, "Gap view", "check/src/gaps.ts", "Rows, cells and derived gaps")
    Component(ladder, "Assertion Ladder", "check/src/ladder.ts", "The rung of each told rule, L2 to L5, from checks, approved obligations and holding total claims; a second axis that moves no outcome")
    Component(report, "Report writer and renderer", "check/src/check.ts, render.ts", "csh-report/v1 and its text rendering")
    Component(signals, "Signals", "check/src/signals.ts", "Every item of a report as a signal with fragments, sources and practices; structured matching")
    Component(overview, "Overview", "check/src/overview.ts", "Every result placed converged, gap or indeterminate with what would move it; the ladder counts and each entry's rung; text and HTML")
    Component(danger, "Danger", "check/src/danger.ts", "Refuted or masked: a view across the outcomes, each entry with its shape, what reads green and what would close it; never scored")
    Component(analysis, "Analysis", "check/src/analysis.ts", "csh-analysis/v1: what an analyse run read, then danger, conflicts, gaps, indeterminate and converged; text and HTML")
    Component(expect, "Expected results", "check/src/expect.ts", "csh-expected/v1 against an overview: rows, counts and rungs")
    Component(refine, "Refiner", "check/src/refine.ts", "Strengthening check for composition")
  }
  Container_Ext(arch, "Architecture rules", "arch", "Set comparisons and structural claims")
  ContainerDb_Ext(z3, "Z3")
  Rel(pool, run, "Fragments and claims")
  Rel(run, queries, "Queries")
  Rel(queries, cache, "CheckInput")
  Rel(cache, port, "On a miss")
  Rel(port, z3, "WebAssembly")
  Rel(run, assess, "Findings")
  Rel(evidence, assess, "Evidence records")
  Rel(run, gaps, "Findings and pool")
  Rel(pool, archwire, "Diagram and facts")
  Rel(archwire, arch, "Rules, claims, diagram, current facts")
  Rel(archwire, assess, "Rule and claim results")
  Rel(archwire, gaps, "Diagram gaps")
  Rel(pool, trace, "Items and edges")
  Rel(trace, results, "Test files and citations")
  Rel(trace, ladder, "What checks each item")
  Rel(assess, ladder, "Assessed obligations and their authority")
  Rel(assess, report, "Assessments")
  Rel(gaps, report, "Gap view")
  Rel(ladder, report, "Rungs")
  Rel(refine, queries, "Entailment")
  Rel(report, signals, "Report and component")
  Rel(signals, overview, "Every signal")
  Rel(overview, expect, "Entries, counts and rungs")
  Rel(danger, overview, "Each entry's danger")
  Rel(report, danger, "Assessments, executions, items and rungs")
  Rel(overview, analysis, "Entries in report order")
