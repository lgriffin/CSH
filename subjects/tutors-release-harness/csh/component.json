{
  "schema": "csh-component/v2",
  "name": "TutorsReleaseHarness",
  "subject": {
    "repo": "https://github.com/tutors-sdk/tutors-release-harness",
    "commit": "195e0d10cccd226f5bafb97898c664b2bf68fbae"
  },
  "implementation": [
    "src"
  ],
  "sources": [
    {
      "name": "Docs",
      "kind": "Documents",
      "at": ".",
      "include": [
        "README.md",
        "TESTING.md",
        "docs/**/*.md",
        "kaizen/**/*.md",
        "claims/README.md",
        "deploy/**/*.md",
        "mutants/README.md"
      ]
    },
    {
      "name": "Tests",
      "kind": "TestFiles",
      "at": "tests",
      "include": [
        "**/*.test.ts"
      ],
      "exclude": [
        "fixtures/**"
      ]
    },
    {
      "name": "Scoreboard",
      "kind": "Issues",
      "at": "scoreboard/releases.jsonl"
    },
    {
      "name": "Mutants",
      "kind": "Traces",
      "at": "mutants/mutants.yaml"
    },
    {
      "name": "Code",
      "kind": "Code",
      "at": ".",
      "include": [
        "src/**/*.ts",
        "bin/*.mjs",
        "package.json",
        "docs/contract/*.json",
        "mutants/mutants.yaml"
      ]
    }
  ],
  "history": {
    "since": "previous-tag",
    "frozen": [
      "docs/releases",
      "kaizen"
    ]
  },
  "practices": [
    {
      "id": "docs",
      "name": "Docs",
      "kind": "documents",
      "sources": [
        "Docs"
      ],
      "author": "Maintainer",
      "unit": "the document"
    },
    {
      "id": "tdd",
      "name": "Tests",
      "kind": "tests",
      "sources": [
        "Tests"
      ],
      "author": "Maintainer",
      "unit": "the test file",
      "executions": "csh/results.json",
      "settings": {
        "citePattern": "slow-ssr-mild|dropped-header|route-500|console-error|dom-note|missing-alt|slow-ssr|anon-write|focus-order|base-swap|added-package|secret-env|vulnerable-package|unsigned-build|extra-chunk|replay-header"
      }
    },
    {
      "id": "scoreboard",
      "name": "Scoreboard",
      "kind": "issues",
      "sources": [
        "Scoreboard"
      ],
      "author": "CI",
      "unit": "the release line"
    },
    {
      "id": "mutants",
      "name": "Mutants",
      "kind": "traces",
      "sources": [
        "Mutants"
      ],
      "author": "Maintainer",
      "unit": "the planted mutant",
      "settings": {
        "collection": "mutants",
        "idField": "name",
        "textField": "plants",
        "fields": "kind"
      }
    },
    {
      "id": "code",
      "name": "Code facts",
      "kind": "facts",
      "sources": [
        "Code"
      ],
      "author": "facts-ts",
      "unit": "the module"
    }
  ],
  "spec": "csh/spec.csl.ts"
}
